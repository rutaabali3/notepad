# Copy this file to .env and replace the placeholder with your MongoDB Atlas connection string.
# Never commit .env or paste real credentials into GitHub.
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/secure-notepad?retryWrites=true&w=majority

# Optional; defaults to 3000 when omitted.
PORT=3000

# Example production configuration:
# MONGO_URI=mongodb+srv://...
# PORT=3000

# If your password contains special characters, URL-encode them first.
# For example: @ becomes %40, # becomes %23, and / becomes %2F.

# Start locally with:
# npm install
# npm start

# Keep .env local. Set MONGO_URI and PORT as environment variables in your hosting provider instead of committing them.
